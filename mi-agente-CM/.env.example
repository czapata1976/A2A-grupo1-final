GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite

# Servidor local que expone el agente por A2A (etapas 2 y 3 del taller).
# El assistant_id es un UUID que el servidor asigna al grafo: se obtiene con
#   POST /assistants/search {"graph_id": "agente_soluciones_comerciales_marketing"}
# El primer servidor del grupo usa el puerto 2025; el segundo, el 2026.
A2A_VIAJES_URL=http://127.0.0.1:2025
A2A_VIAJES_GRAPH=agente_soluciones_comerciales_marketing
