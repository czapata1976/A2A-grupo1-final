# Modelo de los agentes
GOOGLE_API_KEY=
MODELO=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
MODELO_ANTHROPIC=claude-sonnet-5-5

# Telegram
# TELEGRAM_TOKEN lo entrega BotFather. Se deja vacío hasta configurar el bot.
TELEGRAM_TOKEN=
# Secreto que Telegram envía en cada webhook; la API lo verifica.
TELEGRAM_SECRET=cambiame
TELEGRAM_API_BASE=https://api.telegram.org

# Agente que responde si el mensaje no indica otro.
AGENTE_PREDETERMINADO=agente_general

# Logs
LOG_LEVEL=INFO
