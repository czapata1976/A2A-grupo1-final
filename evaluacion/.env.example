# Copia este archivo a evaluacion/.env y completa la clave.
# promptfoo la usa para el modelo que califica la rúbrica (llm-rubric), no para los agentes:
# cada agente lee su propia clave desde su carpeta (mi-agente-cz/.env, agente-bryhan/.env, ...).

GOOGLE_API_KEY=tu_clave_de_gemini
GEMINI_API_KEY=tu_clave_de_gemini
