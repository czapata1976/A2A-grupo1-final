# Copia este archivo a .env y cambia la clave. No incluyas el .env real en la entrega.
# La clave debe tener al menos 12 caracteres; el valor de ejemplo es rechazado a propósito.
API_KEYS=clave-ficticia-de-ejemplo-0000

# Servidores LangGraph que exponen los agentes por A2A.
# Cada agente necesita su propio puerto si corren a la vez.
A2A_SERVIDORES=http://127.0.0.1:2025,http://127.0.0.1:2026
# Para los cuatro agentes del grupo: ...:2025,...:2026,...:2027,...:2028
AGENTE_PRIMARIO=agente_czz
# Catálogo adicional en JSON; vacío usa el catálogo del Grupo 1.
CATALOGO_AGENTES=

# Tiempos y límites.
A2A_TIMEOUT=120
A2A_CONNECT_TIMEOUT=5
A2A_CACHE_TTL=30
A2A_MAX_CONCURRENCIA=4
MAX_AGENTES_POR_CONSULTA=4
RATE_LIMIT_POR_MINUTO=30
SESION_TTL=21600
MAX_SESIONES=500
MAX_CONTEXTO_COLABORATIVO=24000

# Canal Telegram (opcional). Si TELEGRAM_TOKEN está vacío, el webhook responde 503.
TELEGRAM_TOKEN=
TELEGRAM_SECRET=cambiame
TELEGRAM_API_BASE=https://api.telegram.org

# Red y seguridad.
CORS_ORIGINS=
DOCS_HABILITADOS=true
CONFIAR_EN_PROXY=false
AUDIT_LOG=logs/auditoria.jsonl
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Pruebas. 1 activa la integración real; 0 la omite.
A2A_INTEGRATION=0

# El arranque se cambia con -Direccion/-Puerto en scripts/iniciar.ps1
# o exportando SERVICIO_HOST / SERVICIO_PORT en la sesión de PowerShell.
SERVICIO_HOST=127.0.0.1
SERVICIO_PORT=8000
